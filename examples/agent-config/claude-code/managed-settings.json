{
  "env": {
    "ANTHROPIC_BASE_URL": "http://lb:8080",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "CLAUDE_CODE_API_KEY_HELPER_TTL_MS": "240000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "32768",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "ollama/qwen3:8b",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "ollama/qwen3:4b"
  },
  "apiKeyHelper": "/usr/local/bin/aictl token",
  "allowedProviders": [
    "customEndpoint"
  ],
  "availableModels": [
    "ollama/qwen3:8b",
    "ollama/qwen3:4b"
  ],
  "allowManagedMcpServersOnly": true,
  "allowedMcpServers": [
    {
      "serverUrl": "http://lb:8080/mcp/*"
    }
  ],
  "permissions": {
    "disableBypassPermissionsMode": "disable"
  },
  "skipWebFetchPreflight": true,
  "statusLine": {
    "type": "command",
    "command": "/usr/local/bin/aictl status --short",
    "refreshInterval": 30
  }
}
