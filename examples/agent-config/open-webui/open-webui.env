# Open WebUI as the judges' chat client, wired through the gateway
OPENAI_API_BASE_URL=http://gateway.core:8080/v1
OPENAI_API_KEY=vk_openwebui_service      # "trusted front-end" key: only with this key does the gateway honour X-OpenWebUI-User-* headers
ENABLE_FORWARD_USER_INFO_HEADERS=true    # per-user attribution (headers are unsigned, so trust them only with the service key)
ENABLE_OLLAMA_API=false                  # no direct path to Ollama
